<mamecheat version="1">

  <cheat desc="Infinite Credits">
    <script state="run">
      <action>maincpu.pb@8002D=99</action>
    </script>
  </cheat>

  <cheat desc="1 Enemy to Finish Current Scene Now!"> <comment>Also one hit for boss</comment>
    <script state="on">
      <action>maincpu.pw@85C21=0102</action>
    </script>
  </cheat>

  <cheat desc="Select Starting Stage"> <comment>Pause the game during enabling or reset after enabling</comment>
    <parameter>
      <item value="0xFF">Stage 1-1</item>
      <item value="0x00">Stage 1-2</item>
      <item value="0x01">Stage 1-3</item>
      <item value="0x02">Stage 1-4</item>
      <item value="0x03">Stage 2-1</item>
      <item value="0x04">Stage 2-2</item>
      <item value="0x05">Stage 2-3</item>
      <item value="0x06">Stage 2-4</item>
      <item value="0x07">Stage 3-1</item>
      <item value="0x08">Stage 3-2</item>
      <item value="0x09">Stage 3-3</item>
      <item value="0x0A">Stage 3-4</item>
      <item value="0x0B">Stage 4-1</item>
      <item value="0x0C">Stage 4-2</item>
      <item value="0x0D">Stage 4-3</item>
      <item value="0x0E">Stage 4-4</item>
      <item value="0x0F">Final Stage</item>
    </parameter>
    <script state="run">
      <action condition="(maincpu.pb@85C24==FF)">maincpu.pb@85C24=param</action>
    </script>
  </cheat>

  <cheat desc="Invincibility">
    <comment>Sets the game's own switch 080008 (never written by the game): non-zero skips the player's collision tests. No code patch, so it also works with the recompiled program alone.</comment>
    <script state="run">
      <action>maincpu.pb@80008=01</action>
    </script>
    <script state="off">
      <action>maincpu.pb@80008=00</action>
    </script>
  </cheat>

